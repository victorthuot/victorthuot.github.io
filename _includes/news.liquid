<div class="news">
  {% assign categories = 'conference,talk,local' | split: ',' %}
  {% if page.lang == 'fr' %}
    {% assign section_titles = 'Conférences avec actes,Exposés,Vie locale' | split: ',' %}
  {% else %}
    {% assign section_titles = 'Conferences with proceedings,Talks,Local activities' | split: ',' %}
  {% endif %}

  {% assign all_news = site.data.news | sort: 'date' | reverse %}

  {% for current_category in categories %}
    {% assign filtered_news = all_news | where: 'category', current_category %}
    {% if filtered_news != empty %}
      <h2>{{ section_titles[forloop.index0] }}</h2>
      {% include news_rows.liquid items=filtered_news %}
    {% endif %}
  {% endfor %}
</div>
