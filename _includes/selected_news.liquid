{% assign sorted_news = site.data.news | sort: 'date' | reverse %}

{%- comment -%}
  Separate selected and unselected news
{%- endcomment -%}
{% assign selected_news = sorted_news | where: 'selected', true %}
{% assign unselected_news = sorted_news | where_exp: 'item', 'item.selected != true' %}

{%- comment -%}
  Limit selected news to selected_limit
{%- endcomment -%}
{% assign selected_limit = site.announcements.selected_limit | default: 2 %}
{% assign limited_selected = selected_news | slice: 0, selected_limit %}

{%- comment -%}
  Fill the rest with unselected news to reach the total limit
{%- endcomment -%}
{% assign news_limit = site.announcements.news_limit | default: site.announcements.limit | default: 5 %}
{% assign remaining_limit = news_limit | minus: limited_selected.size %}
{% if remaining_limit > 0 %}
  {% assign limited_unselected = unselected_news | slice: 0, remaining_limit %}
{% else %}
  {% assign limited_unselected = '' | split: '' %}
{% endif %}

{%- comment -%}
  Merge and display news
{%- endcomment -%}
{% assign final_news = limited_selected | concat: limited_unselected | sort: 'date' | reverse %}
<div class="news">
  <div
    {% if site.announcements.scrollable and final_news.size > 3 %}
      style="max-height: 60vw; overflow-y: auto;"
    {% endif %}
  >
    {% include news_rows.liquid items=final_news %}
  </div>
</div>
